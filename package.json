{
    "name": "skrapa",
    "version": "0.6.0",
    "author": "iambriansreed",
    "homepage": "https://skrapa.iambrian.com",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/iambriansreed/skrapa.git"
    },
    "bugs": {
        "url": "https://github.com/iambriansreed/skrapa/issues"
    },
    "keywords": [
        "static-site-generator",
        "ssg",
        "jsx",
        "typescript",
        "static-site",
        "zero-dependency",
        "zero-config",
        "npx"
    ],
    "scripts": {
        "build": "npx tsx src/scripts/build.ts",
        "dev": "npx tsx src/scripts/dev.ts",
        "test": "npm run test:unit && npm run test:e2e",
        "test:e2e": "npx tsx src/scripts/test.ts",
        "test:unit": "npx tsx --test \"src/**/*.test.ts\"",
        "lint": "npx eslint .",
        "lint:fix": "npm run lint -- --fix",
        "lint:css": "npx stylelint \"assets/**/*.css\" \"src/**/*.css\" \"template/**/*.css\"",
        "clean": "rm -rf dist bin .tmp .skrapa template/dist template/.skrapa",
        "prepack": "npm run build && rm -rf template/.skrapa template/dist",
        "release": "commit-and-tag-version && npm run build && git push --follow-tags && npm login && npm publish"
    },
    "files": [
        "bin/",
        "template/",
        "skrapa.d.ts"
    ],
    "bin": {
        "skrapa": "bin/index.js"
    },
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@eslint/json": "^2.0.1",
        "@types/node": "^25.9.5",
        "commit-and-tag-version": "^12.7.3",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^63.3.2",
        "eslint-plugin-prettier": "^5.5.6",
        "prettier": "^3.8.4",
        "stylelint": "^17.13.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0"
    },
    "engines": {
        "node": ">=24"
    },
    "description": "Build static sites with TypeScript JSX templates and TypeScript client-side code. No framework, no virtual DOM, no config. A single zero-dependency script, run with npx."
}
