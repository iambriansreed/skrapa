{
    "skrapa": {
        "output": "../dist",
        "assets": "../assets",
        "port": 8080,
        "projectRoot": "../"
    },
    "compilerOptions": {
        "composite": true,
        "target": "ES2020",
        "module": "commonjs",
        "jsx": "react",
        "jsxFactory": "jsx",
        "jsxFragmentFactory": "Fragment",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["DOM", "DOM.Iterable", "ES2020"]
    },
    "include": ["**/*.ts", "**/*.tsx", "../skrapa.d.ts"],
    "exclude": ["node_modules", "dist"]
}
