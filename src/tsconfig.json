{
    "compilerOptions": {
        "incremental": true,
        "target": "ES2020",
        "module": "commonjs",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "../.skrapa",
        "rootDir": "..",
        "lib": ["DOM", "DOM.Iterable", "ES2020"],
        "types": ["node"]
    },
    "include": ["**/*.ts", "../skrapa.d.ts"]
}
