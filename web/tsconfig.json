{
    "skrapa": {
        "output": "../dist",
        "port": 8090,
        "host": "localhost",
        "origin": "https://skrapa.localhost",
        "projectRoot": "../"
    },
    "compilerOptions": {
        "composite": true,
        "target": "ES2020",
        "module": "commonjs",
        "jsx": "react",
        "jsxFactory": "jsx",
        "jsxFragmentFactory": "Fragment",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["DOM", "DOM.Iterable", "ES2020"],
        "types": ["node"]
    },
    "include": ["**/*.ts", "**/*.tsx", "../skrapa.d.ts"],
    "exclude": ["node_modules", "dist", "template", "bin", "build"]
}
